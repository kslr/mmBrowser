	<key>settings.trashDays %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Keep in Trash: %lld day</string>
			<key>other</key>
			<string>Keep in Trash: %lld days</string>
		</dict>
	</dict>
	<key>sidebar.deleteTag.message %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>This only removes the tag from %lld profile. The profile itself isn’t deleted.</string>
			<key>other</key>
			<string>This only removes the tag from %lld profiles. The profiles themselves aren’t deleted.</string>
		</dict>
	</dict>
	<key>sidebar.expiring.help %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
