		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Expired %lld day ago</string>
			<key>other</key>
			<string>Expired %lld days ago</string>
		</dict>
	</dict>
