			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Without proxies, create %lld profile (assign proxies later)</string>
			<key>other</key>
			<string>Without proxies, create %lld profiles (assign proxies later)</string>
		</dict>
	</dict>
