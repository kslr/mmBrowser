<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>alert.runningLimit.message %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld profile wasn’t launched. Close some profiles or raise the limit in Settings.</string>
			<key>other</key>
			<string>%lld profiles weren’t launched. Close some profiles or raise the limit in Settings.</string>
		</dict>
	</dict>
	<key>assign.header %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Assign proxies one by one, in number order, to the %lld selected profile</string>
			<key>other</key>
			<string>Assign proxies one by one, in number order, to the %lld selected profiles</string>
		</dict>
	</dict>
